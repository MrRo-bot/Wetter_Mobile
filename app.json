{
  "expo": {
    "name": "Wetter",
    "slug": "Wetter_Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icons/adaptive-icon.png",
    "scheme": "wettermobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": {
        "dark": "./src/assets/icons/ios-dark.png",
        "light": "./src/assets/icons/ios-light.png",
        "tinted": "./src/assets/icons/ios-tinted.png"
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/adaptive-icon.png",
        "monochromeImage": "./src/assets/icons/adaptive-icon.png",
        "backgroundColor": "#fefbfb"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.chhavimani.Wetter_Mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/icons/adaptive-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icons/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fefbfb",
          "dark": {
            "image": "./src/assets/icons/splash-icon-light.png",
            "backgroundColor": "#0e0b0b"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Genos",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/Genos-Thin.otf",
                    "weight": 100,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Genos-ExtraLight.otf",
                    "weight": 200,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Genos-Light.otf",
                    "weight": 300,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Genos-Regular.otf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Genos-Medium.otf",
                    "weight": 500,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Genos-SemiBold.otf",
                    "weight": 600,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Genos-Bold.otf",
                    "weight": 700,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Genos-ExtraBold.otf",
                    "weight": 800,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Genos-Black.otf",
                    "weight": 900,
                    "style": "normal"
                  }
                ]
              },
              {
                "fontFamily": "Orbitron",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/Orbitron-Regular.otf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Orbitron-Medium.otf",
                    "weight": 500,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Orbitron-SemiBold.otf",
                    "weight": 600,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Orbitron-Bold.otf",
                    "weight": 700,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Orbitron-ExtraBold.otf",
                    "weight": 800,
                    "style": "normal"
                  },
                  {
                    "path": "./src/assets/fonts/Orbitron-Black.otf",
                    "weight": 900,
                    "style": "normal"
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./src/assets/fonts/Genos-Thin.otf",
              "./src/assets/fonts/Genos-ExtraLight.otf",
              "./src/assets/fonts/Genos-Light.otf",
              "./src/assets/fonts/Genos-Regular.otf",
              "./src/assets/fonts/Genos-Medium.otf",
              "./src/assets/fonts/Genos-SemiBold.otf",
              "./src/assets/fonts/Genos-Bold.otf",
              "./src/assets/fonts/Genos-ExtraBold.otf",
              "./src/assets/fonts/Genos-Black.otf",
              "./src/assets/fonts/Orbitron-Regular.otf",
              "./src/assets/fonts/Orbitron-Medium.otf",
              "./src/assets/fonts/Orbitron-SemiBold.otf",
              "./src/assets/fonts/Orbitron-Bold.otf",
              "./src/assets/fonts/Orbitron-ExtraBold.otf",
              "./src/assets/fonts/Orbitron-Black.otf"
            ]
          }
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./src/assets/images/alert.gif",
            "./src/assets/images/aqi_meter.png",
            "./src/assets/images/blades.png",
            "./src/assets/images/direction.png",
            "./src/assets/images/hot_alert.gif",
            "./src/assets/images/introduction.png",
            "./src/assets/images/location.gif",
            "./src/assets/images/search.gif",
            "./src/assets/images/wind_mill.png",
            "./src/assets/images/brief/clock.gif",
            "./src/assets/images/brief/dew_point.gif",
            "./src/assets/images/brief/humidity.gif",
            "./src/assets/images/brief/pressure.gif",
            "./src/assets/images/brief/sunrise.gif",
            "./src/assets/images/brief/sunset.gif",
            "./src/assets/images/brief/thermometer.gif",
            "./src/assets/images/brief/uv.gif",
            "./src/assets/images/brief/visibility.gif",
            "./src/assets/images/weatherType/clear_day.gif",
            "./src/assets/images/weatherType/clear_night.gif",
            "./src/assets/images/weatherType/dense_drizzle.gif",
            "./src/assets/images/weatherType/fog.gif",
            "./src/assets/images/weatherType/freezing_drizzle.gif",
            "./src/assets/images/weatherType/hail.gif",
            "./src/assets/images/weatherType/heavy_rain.gif",
            "./src/assets/images/weatherType/heavy_snow.gif",
            "./src/assets/images/weatherType/heavy_thunder_with_hail.gif",
            "./src/assets/images/weatherType/moderate_drizzle.gif",
            "./src/assets/images/weatherType/moderate_rain.gif",
            "./src/assets/images/weatherType/moderate_snow.gif",
            "./src/assets/images/weatherType/overcast.gif",
            "./src/assets/images/weatherType/partly_cloudy_day.gif",
            "./src/assets/images/weatherType/partly_cloudy_night.gif",
            "./src/assets/images/weatherType/slight_rain.gif",
            "./src/assets/images/weatherType/slight_snow.gif",
            "./src/assets/images/weatherType/slight_thunder_with_hail.gif",
            "./src/assets/images/weatherType/thunderstorm.gif",
            "./src/assets/images/weatherType/tornado.gif"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Wetter to use your location",
          "isAndroidBackgroundLocationEnable": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db8c938f-13ae-424b-a7d2-83bb012f2f49"
      }
    },
    "owner": "chhavimani"
  }
}
